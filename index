<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>نظام المدفوعات الفورية IPN | الهوية المصرفية الإماراتية</title>
    
    <!-- ===== إعدادات صورة المعاينة (واتساب وتويتر وغيرها) ===== -->
    <meta property="og:title" content="نظام المدفوعات الفورية IPN | مصرف الإمارات المركزي">
