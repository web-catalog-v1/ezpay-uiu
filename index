    <!-- إعدادات خاصة بتويتر (Twitter Card) -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="نظام المدفوعات الفورية IPN | مصرف الإمارات المركزي">
    <meta name="twitter:description" content="منصة المدفوعات الفورية المعتمدة — تحويلات فورية، آمنة، وموثقة.">
    <meta name="twitter:image" content="https://i.ibb.co/tTqjxFK2/file-00000000507c8210bdef1efdd01e6e4e.png">

    <!-- الخطوط -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@300;400;500;600;700;800;900&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* ========== المتغيرات ========== */
        :root {
            --white: #ffffff;
            --off-white: #f8f9fb;
            --light-gray: #eceef2;
            --silver: #c4c9d4;
            --gold: #b8963e;
            --gold-dark: #96782a;
            --gold-light: #e3d3a3;
            --gold-pale: #f7f2e4;
            --navy: #071a33;
            --navy-light: #0e2545;
            --navy-soft: #16325c;
            --text-dark: #06101f;
            --text-muted: #556377;
            --orange: #d97706;
            --orange-bg: #fffbeb;
            --shadow-sm: 0 2px 8px rgba(7, 26, 51, 0.06);
            --shadow-md: 0 6px 24px rgba(7, 26, 51, 0.08);
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 16px;
            --font-kufi: 'Noto Kufi Arabic', sans-serif;
            --font-plex: 'IBM Plex Sans Arabic', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }

        body {
            font-family: var(--font-plex);
            background-color: var(--off-white);
            color: var(--text-dark);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            background-image:
                radial-gradient(ellipse at 10% 0%, rgba(184, 150, 62, 0.04) 0%, transparent 45%),
                radial-gradient(ellipse at 90% 100%, rgba(7, 26, 51, 0.03) 0%, transparent 45%);
            background-attachment: fixed;
        }

        /* ========== شريط علوي ========== */
        .top-bar {
            width: 100%;
            background: linear-gradient(90deg, #051227 0%, var(--navy-soft) 50%, #051227 100%);
            color: var(--gold-light);
            padding: 8px 0;
            font-family: var(--font-kufi);
            font-size: 10.5px;
            font-weight: 500;
            letter-spacing: 0.3px;
            position: relative;
        }
        .top-bar::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
        }
        .top-bar-content {
            max-width: 1120px;
            margin: 0 auto;
            padding: 0 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }
        .top-bar-content span { display: flex; align-items: center; gap: 5px; }
        .top-bar svg { width: 11px; height: 11px; fill: currentColor; }

        /* ========== الحاوية ========== */
        .main-container {
            width: 100%;
            max-width: 1120px;
            padding: 20px 16px 40px;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* ========== الهيدر ========== */
        .brand-header {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 0 16px;
            border-bottom: 1px solid var(--silver);
            margin-bottom: 24px;
            position: relative;
        }
        .brand-header::after {
            content: '';
            position: absolute;
            bottom: -1px; right: 0;
            width: 100px; height: 2px;
            background: linear-gradient(90deg, var(--gold), transparent);
        }
        .brand-right { display: flex; align-items: center; gap: 12px; }

        .emblem {
            width: 56px; height: 56px;
            border-radius: 50%;
            background: linear-gradient(145deg, var(--navy), var(--navy-soft));
            display: flex; align-items: center; justify-content: center;
            position: relative;
            box-shadow: var(--shadow-md), inset 0 0 0 1.5px rgba(184, 150, 62, 0.35);
            flex-shrink: 0;
        }
        .emblem svg { width: 26px; height: 26px; fill: var(--gold-light); z-index: 1; }

        .brand-text h1 {
            font-family: var(--font-kufi);
            font-size: 15px;
            font-weight: 700;
            color: var(--navy);
            margin-bottom: 2px;
        }
        .brand-text p {
            font-size: 10.5px;
            color: var(--text-muted);
        }
        .brand-left { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }

        .secure-badge {
            display: flex;
            align-items: center;
            gap: 5px;
            background: rgba(184, 150, 62, 0.08);
            border: 1px solid rgba(184, 150, 62, 0.25);
            border-radius: 100px;
            padding: 4px 10px 4px 7px;
            font-size: 9.5px;
            font-weight: 600;
            color: var(--gold-dark);
            font-family: var(--font-kufi);
        }
        .secure-badge svg { width: 11px; height: 11px; fill: var(--gold-dark); }
        .timestamp { font-size: 9px; color: var(--text-muted); }

        /* ========== Hero ========== */
        .ipn-hero { width: 100%; text-align: center; margin-bottom: 20px; }

        .ipn-icon-wrap {
            display: inline-flex;
            align-items: center; justify-content: center;
            width: 44px; height: 44px;
            border-radius: 12px;
            background: linear-gradient(145deg, var(--navy), var(--navy-light));
            margin-bottom: 10px;
            box-shadow: var(--shadow-md), 0 0 0 1px rgba(184, 150, 62, 0.15);
        }
        .ipn-icon-wrap svg { width: 20px; height: 20px; fill: var(--gold-light); }

        .ipn-hero h2 {
            font-family: var(--font-kufi);
            font-size: 19px;
            font-weight: 800;
            color: var(--navy);
            margin-bottom: 4px;
        }
        .ipn-hero .subtitle {
            font-size: 11px;
            color: var(--text-muted);
            max-width: 540px;
            margin: 0 auto;
            line-height: 1.6;
        }
        .gold-divider {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 10px;
        }
        .gold-divider .line { width: 30px; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
        .gold-divider .diamond { width: 4px; height: 4px; background: var(--gold); transform: rotate(45deg); }

        /* ========== الشبكة ========== */
        .cards-grid {
            width: 100%;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        /* ========== بطاقة الدفع ========== */
        .payment-card {
            background: var(--white);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(196, 201, 212, 0.4);
            overflow: hidden;
            position: relative;
        }
        .payment-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--navy), var(--gold), var(--navy));
        }

        .card-header {
            padding: 16px 18px 14px;
            border-bottom: 1px solid var(--light-gray);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .card-header h3 {
            font-family: var(--font-kufi);
            font-size: 14px;
            font-weight: 700;
            color: var(--navy);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .card-header h3 svg { width: 15px; height: 15px; fill: var(--gold-dark); }

        .status-dot {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 9.5px;
            color: var(--orange);
            font-weight: 600;
            background: var(--orange-bg);
            padding: 2px 8px 2px 6px;
            border-radius: 100px;
        }
        .status-dot::before {
            content: '';
            width: 5px; height: 5px;
            border-radius: 50%;
            background: var(--orange);
            animation: pulse-dot 2s infinite;
        }
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.35; }
        }

        .card-body { padding: 16px 18px 20px; }

        /* المبلغ */
        .amount-display {
            text-align: center;
            padding: 14px 0 16px;
            margin-bottom: 16px;
            background: linear-gradient(180deg, rgba(247, 242, 228, 0.45), transparent);
            border-radius: var(--radius-md);
            border: 1px dashed rgba(184, 150, 62, 0.35);
        }
        .amount-label { font-size: 10px; color: var(--text-muted); margin-bottom: 2px; }
        .amount-value {
            font-family: var(--font-kufi);
            font-size: 32px;
            font-weight: 800;
            color: var(--navy);
            display: flex;
            align-items: baseline;
            justify-content: center;
            gap: 6px;
            direction: ltr;
        }
        .amount-value .currency {
            font-size: 12px;
            font-weight: 700;
            color: var(--gold-dark);
            background: rgba(184, 150, 62, 0.1);
            padding: 2px 6px;
            border-radius: 4px;
            order: -1;
        }
        .amount-ref { font-size: 9px; color: var(--text-muted); margin-top: 4px; direction: ltr; }

        /* تصميم حقول البطاقة (أبيض ونظيف) */
        .global-card-box {
            background: var(--off-white);
            border: 1.5px solid var(--light-gray);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
            box-shadow: inset 0 1px 4px rgba(0,0,0,0.02);
        }
        .g-form-group { margin-bottom: 12px; }
        .g-form-group label {
            display: block;
            font-size: 10px;
            color: var(--navy);
            font-weight: 600;
            margin-bottom: 5px;
            font-family: var(--font-kufi);
        }
        .g-input {
            width: 100%;
            background: var(--white);
            border: 1.5px solid var(--silver);
            border-radius: 6px;
            padding: 10px 12px;
            color: var(--text-dark);
            font-family: var(--font-plex);
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
        }
        .g-input:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(184, 150, 62, 0.1); }
        .g-input::placeholder { color: #a5aebb; font-size: 13px; }
        .g-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .error-msg {
            color: #e53e3e;
            font-size: 9.5px;
            margin-top: 4px;
            display: none;
            font-weight: 600;
        }
        .g-input.invalid { border-color: #e53e3e; background: #fff5f5; }

        /* قائمة البنوك المنسدلة */
        .bank-selector-label {
            font-size: 10.5px;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: 8px;
            font-family: var(--font-kufi);
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .bank-selector-label svg { width: 12px; height: 12px; fill: var(--gold-dark); }

        .bank-select-wrap {
            position: relative;
            margin-bottom: 16px;
        }
        .bank-select {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid var(--light-gray);
            border-radius: var(--radius-sm);
            background-color: var(--white);
            font-family: var(--font-plex);
            font-size: 13px;
            font-weight: 500;
            color: var(--navy);
            cursor: pointer;
            outline: none;
            appearance: none;
            -webkit-appearance: none;
            transition: all 0.2s ease;
        }
        .bank-select:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(184, 150, 62, 0.1);
        }
        .bank-select-arrow {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px; height: 16px;
            fill: var(--navy);
            pointer-events: none;
        }
        .bank-select option {
            font-family: var(--font-plex);
            font-size: 14px;
            padding: 10px;
        }
        .bank-select option[value=""] { color: var(--text-muted); }

        /* زر الدفع */
        .pay-btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: var(--radius-sm);
            background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 50%, var(--navy-soft) 100%);
            color: var(--gold-light);
            font-family: var(--font-kufi);
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px rgba(7, 26, 51, 0.22);
        }
        .pay-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(7, 26, 51, 0.28);
        }
        .pay-btn svg { width: 14px; height: 14px; fill: var(--gold-light); }

        .security-note {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            margin-top: 10px;
            font-size: 9px;
            color: var(--text-muted);
        }
        .security-note svg { width: 10px; height: 10px; fill: #1b6b23; }

        /* ========== بطاقة التوثيق ========== */
        .verification-card {
            background: var(--white);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(196, 201, 212, 0.4);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .verification-header {
            background: linear-gradient(145deg, var(--navy) 0%, var(--navy-soft) 100%);
            padding: 16px;
            color: var(--white);
            position: relative;
        }
        .v-title { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
        .v-title svg { width: 16px; height: 16px; fill: var(--gold-light); }
        .v-title h4 { font-family: var(--font-kufi); font-size: 13px; font-weight: 700; }
        .v-subtitle { font-size: 9.5px; color: rgba(255, 255, 255, 0.65); }

        .verification-body { padding: 16px; flex: 1; display: flex; flex-direction: column; }

        .verification-code-box {
            background: linear-gradient(145deg, var(--gold-pale), var(--white));
            border: 1.5px solid rgba(184, 150, 62, 0.3);
            border-radius: var(--radius-md);
            padding: 14px 12px;
            text-align: center;
            margin-bottom: 16px;
        }
        .code-label { font-size: 8.5px; color: var(--text-muted); font-weight: 600; margin-bottom: 6px; font-family: var(--font-kufi); }
        .code-value {
            font-family: var(--font-kufi);
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 5px;
            color: var(--navy);
            direction: ltr;
        }
        .code-hint { font-size: 8.5px; color: var(--text-muted); margin-top: 6px; display: flex; align-items: center; justify-content: center; gap: 3px; }
        .code-hint svg { width: 9px; height: 9px; fill: #1b6b23; }

        .txn-details { display: flex; flex-direction: column; margin-bottom: 14px; }
        .txn-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 8px 0; border-bottom: 1px solid var(--light-gray); font-size: 10.5px;
        }
        .txn-label { color: var(--text-muted); display: flex; align-items: center; gap: 4px; }
        .txn-label svg { width: 11px; height: 11px; fill: var(--silver); }
        .txn-value { font-weight: 600; color: var(--navy); font-size: 11px; display: flex; align-items: center; gap: 4px; }
        .currency-tag { font-size: 8.5px; color: var(--gold-dark); background: rgba(184, 150, 62, 0.1); padding: 1px 5px; border-radius: 3px; }
        .status-badge { font-size: 8.5px; color: var(--orange); background: var(--orange-bg); padding: 2px 6px; border-radius: 100px; }

        .bank-logos-section { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--light-gray); }
        .bank-logos-label { font-size: 8.5px; color: var(--text-muted); text-align: center; margin-bottom: 8px; }
        .bank-logos-row { display: flex; align-items: center; justify-content: center; gap: 5px; flex-wrap: wrap; }
        .bank-logo-badge {
            display: flex; align-items: center; gap: 3px;
            padding: 3px 6px; border: 1px solid var(--light-gray);
            border-radius: 4px; background: var(--white);
        }
        .mini-circle {
            width: 14px; height: 14px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 6.5px; font-weight: 800; color: white;
        }
        .bank-logo-badge span { font-size: 7.5px; font-weight: 600; color: var(--text-muted); white-space: nowrap; }

        /* ========== صفحة الـ OTP ========== */
        #otpPage {
            display: none;
            width: 100%;
            max-width: 450px;
            margin: 40px auto;
            animation: fadeIn 0.4s ease;
        }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        
        .otp-card {
            background: var(--white);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            border: 1px solid rgba(196, 201, 212, 0.4);
            overflow: hidden;
            position: relative;
        }
        .otp-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--navy), var(--gold), var(--navy));
        }
        .otp-header {
            text-align: center;
            padding: 24px 20px 16px;
            border-bottom: 1px solid var(--light-gray);
        }
        .otp-header svg { width: 40px; height: 40px; fill: var(--navy); margin-bottom: 10px; }
        .otp-header h2 { font-family: var(--font-kufi); font-size: 18px; color: var(--navy); margin-bottom: 4px; }
        .otp-header p { font-size: 11px; color: var(--text-muted); line-height: 1.5; }
        
        .otp-body { padding: 24px 20px; text-align: center; }
        
        /* حقل الإدخال الواحد للـ OTP */
        .otp-single-input {
            width: 100%;
            max-width: 320px;
            margin: 0 auto 20px;
            padding: 14px;
            border: 2px solid var(--silver);
            border-radius: 8px;
            text-align: center;
            font-size: 28px;
            font-weight: 800;
            color: var(--navy);
            letter-spacing: 12px;
            outline: none;
            transition: all 0.2s;
            font-family: var(--font-kufi);
            background: var(--off-white);
            direction: ltr;
        }
        .otp-single-input:focus {
            border-color: var(--gold);
            background: var(--white);
            box-shadow: 0 0 0 4px rgba(184, 150, 62, 0.15);
        }
        .otp-single-input::placeholder {
            letter-spacing: 12px;
            color: #cbd5e1;
        }
        
        .otp-btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: var(--radius-sm);
            background: linear-gradient(135deg, var(--navy) 0%, var(--navy-soft) 100%);
            color: var(--gold-light);
            font-family: var(--font-kufi);
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s ease;
        }
        .otp-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(7, 26, 51, 0.2); }
        
        .otp-timer { font-size: 11px; color: var(--text-muted); margin-top: 16px; }
        .otp-timer span { color: var(--gold-dark); font-weight: 700; }
        
        .resend-link { 
            display: none; 
            margin-top: 16px; 
            color: var(--gold-dark); 
            font-size: 11px; 
            cursor: pointer; 
            font-weight: 600;
            text-decoration: underline;
        }
        .resend-link:hover { color: var(--navy); }

        .error-alert {
            display: none;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            padding: 10px;
            border-radius: 6px;
            font-size: 11px;
            margin-bottom: 16px;
            text-align: center;
        }

        /* Loading Overlay */
        .loading-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(7, 26, 51, 0.85);
            backdrop-filter: blur(4px);
            z-index: 9999;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
        }
        .loading-spinner {
            width: 40px; height: 40px;
            border: 3px solid rgba(255,255,255,0.2);
            border-top-color: var(--gold);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 16px;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ========== الفوتر ========== */
        .page-footer {
